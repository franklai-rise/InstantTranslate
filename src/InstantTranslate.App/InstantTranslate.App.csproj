<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppLogo.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>InstantTranslate</AssemblyName>
    <RootNamespace>InstantTranslate</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Frank Lai</Authors>
    <Description>Fast global text-selection translation for Windows, powered by DeepSeek.</Description>
    <RepositoryUrl>https://github.com/franklai-rise/InstantTranslate</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppLogo.ico" />
    <Resource Include="Assets\AppLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>InstantTranslate.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
