<Window x:Class="InstantTranslate.Windows.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        WindowStyle="None"
        ResizeMode="CanResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="True"
        FontFamily="{DynamicResource InterfaceFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="PopupWindow_SizeChanged"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PopupTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="320" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="80" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PopupButtonHoverBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Pinned">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PopupButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource PopupMutedBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,4" />
        </Style>

        <ControlTemplate x:Key="SliderTrackTemplate" TargetType="RepeatButton">
            <Border Height="3"
                    Margin="0,0"
                    VerticalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    CornerRadius="1.5" />
        </ControlTemplate>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="18" Height="18" Background="Transparent">
                            <Ellipse x:Name="ThumbCore"
                                     Width="14"
                                     Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource AccentBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbCore" Property="Width" Value="16" />
                                <Setter TargetName="ThumbCore" Property="Height" Value="16" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbCore" Property="Fill" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FontSizeSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Margin="2,0"
                                   VerticalAlignment="Center"
                                   IsDirectionReversed="False"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Value="{TemplateBinding Value}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource AccentBrush}"
                                                  Command="{x:Static Slider.DecreaseLarge}"
                                                  Focusable="False"
                                                  Template="{StaticResource SliderTrackTemplate}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource PopupButtonHoverBrush}"
                                                  Command="{x:Static Slider.IncreaseLarge}"
                                                  Focusable="False"
                                                  Template="{StaticResource SliderTrackTemplate}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ContentRow" Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ActionBarSurface"
                Grid.Row="0"
                Margin="0,0,4,7"
                Padding="5,4"
                Visibility="Collapsed"
                Background="{DynamicResource PopupButtonBrush}"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="11"
                HorizontalAlignment="Right">
            <StackPanel x:Name="ActionPanel"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock x:Name="ActionStatusText"
                           Margin="7,0,6,0"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="Copied" />
                <Button x:Name="FontSizeButton"
                        Width="38"
                        Style="{StaticResource ActionButtonStyle}"
                        Content="Aa"
                        FontSize="12"
                        FontWeight="SemiBold"
                        ToolTip="Text size"
                        Click="FontSizeButton_Click" />
                <StackPanel x:Name="FontSizePanel"
                            Margin="3,0,5,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ToolTip="Drag to adjust text size">
                    <Slider x:Name="FontSizeSlider"
                            Width="82"
                            Minimum="12"
                            Maximum="30"
                            Value="16.5"
                            SmallChange="0.5"
                            LargeChange="2"
                            TickFrequency="0.5"
                            IsSnapToTickEnabled="False"
                            Style="{StaticResource FontSizeSliderStyle}"
                            ValueChanged="FontSizeSlider_ValueChanged" />
                    <TextBlock x:Name="FontSizeValueText"
                               Width="25"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PopupMutedBrush}"
                               FontSize="10.5"
                               Text="16.5"
                               TextAlignment="Right" />
                </StackPanel>
                <Button x:Name="DirectionButton"
                        Width="Auto"
                        MinWidth="76"
                        Margin="2,0,2,0"
                        Padding="10,4"
                        Style="{StaticResource ActionButtonStyle}"
                        FontSize="12"
                        FontWeight="Medium"
                        Content="To Chinese"
                        ToolTip="Switch translation language"
                        Click="DirectionButton_Click" />
                <Border Margin="3,0,2,0"
                        Padding="2"
                        Background="{DynamicResource PopupBackgroundBrush}"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="5,0,3,0">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource PopupMutedBrush}"
                                      Data="M8,3H19A2,2 0 0 1 21,5V16A2,2 0 0 1 19,18H17V16H19V5H8V7H6V5A2,2 0 0 1 8,3ZM5,7H14A2,2 0 0 1 16,9V20A2,2 0 0 1 14,22H5A2,2 0 0 1 3,20V9A2,2 0 0 1 5,7ZM5,9V20H14V9H5Z" />
                            </Canvas>
                        </Viewbox>
                        <Button x:Name="CopySourceButton"
                                Style="{StaticResource TextActionButtonStyle}"
                                Content="Source"
                                ToolTip="Copy source"
                                Click="CopySourceButton_Click" />
                        <Button x:Name="CopyTranslationButton"
                                Style="{StaticResource TextActionButtonStyle}"
                                Content="Translation"
                                ToolTip="Copy translation"
                                Click="CopyTranslationButton_Click" />
                    </StackPanel>
                </Border>
                <Button x:Name="PinButton"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="Keep window"
                        Click="PinButton_Click">
                    <Grid Width="24" Height="24">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M16,9V4L17,3V2H7V3L8,4V9C8,10.66 6.66,12 5,12V14H11V21H13V14H19V12C17.34,12 16,10.66 16,9Z" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="Close"
                        Click="CloseButton_Click">
                    <Grid Width="24" Height="24">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M6,6 L18,18 M18,6 L6,18" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="PopupSurface"
                Grid.Row="1"
                MaxWidth="820"
                MaxHeight="600"
                ClipToBounds="True"
                Padding="16,14"
                CornerRadius="12"
                Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="Transparent"
                BorderThickness="0"
                MouseLeftButtonDown="PopupSurface_MouseLeftButtonDown">
            <Grid>
                <StackPanel x:Name="LoadingPanel"
                            MinWidth="150"
                            Margin="0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="LoadingTextBlock"
                               MaxWidth="420"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PopupTextBrush}"
                               FontSize="13.5"
                               TextWrapping="Wrap"
                               Text="Translating…" />
                </StackPanel>

                <RichTextBox x:Name="TranslationRichTextBox"
                             MinWidth="220"
                             MaxWidth="788"
                             MaxHeight="548"
                             Margin="0"
                             Padding="0"
                             Visibility="Collapsed"
                             Background="Transparent"
                             Foreground="{DynamicResource PopupTextBrush}"
                             BorderThickness="0"
                             FontFamily="Times New Roman"
                             FontSize="16.5"
                             IsReadOnly="True"
                             IsUndoEnabled="False"
                             IsDocumentEnabled="False"
                             IsInactiveSelectionHighlightEnabled="True"
                             Focusable="True"
                             Cursor="IBeam"
                             SelectionBrush="{DynamicResource AccentLightBrush}"
                             SelectionOpacity="0.42"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             ScrollViewer.PanningMode="VerticalOnly"
                             PreviewMouseLeftButtonDown="TranslationRichTextBox_PreviewMouseLeftButtonDown">
                    <RichTextBox.ContextMenu>
                        <ContextMenu FontFamily="{DynamicResource InterfaceFont}"
                                     FontSize="12.5">
                            <MenuItem x:Name="CopySelectionMenuItem"
                                      Header="Copy"
                                      Command="{x:Static ApplicationCommands.Copy}"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem x:Name="SelectAllMenuItem"
                                      Header="Select all"
                                      Command="{x:Static ApplicationCommands.SelectAll}"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                </RichTextBox>
            </Grid>
        </Border>
    </Grid>
</Window>
