<Window x:Class="InstantTranslate.Windows.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="{DynamicResource PopupButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PopupTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PopupButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PopupButtonHoverBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Pinned">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="PopupSurface"
            MaxWidth="560"
            MaxHeight="380"
            Padding="12"
            CornerRadius="9"
            Background="{DynamicResource PopupBackgroundBrush}"
            BorderBrush="{DynamicResource PopupBorderBrush}"
            BorderThickness="1"
            MouseLeftButtonDown="PopupSurface_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="LoadingPanel"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        MinWidth="112"
                        Margin="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Grid Width="20" Height="20" Margin="0,0,9,0">
                    <Ellipse Stroke="{DynamicResource PopupMutedBrush}" StrokeThickness="2" />
                    <Ellipse Stroke="{DynamicResource PopupTextBrush}"
                             StrokeThickness="2.3"
                             StrokeDashArray="2,4"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.75"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource PopupTextBrush}"
                           FontFamily="Segoe UI, Microsoft YaHei UI"
                           FontSize="14"
                           Text="正在翻译…" />
            </StackPanel>

            <StackPanel x:Name="ActionPanel"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="DirectionButton"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="切换翻译语言"
                        Click="DirectionButton_Click">
                    <Viewbox Width="17" Height="17">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M6.99,11 3,15 6.99,19 6.99,16 14,16 14,14 6.99,14ZM17.01,5 17.01,8 10,8 10,10 17.01,10 17.01,13 21,9Z" />
                    </Viewbox>
                </Button>
                <Button x:Name="CopySourceButton"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="复制原文"
                        Click="CopySourceButton_Click">
                    <Grid Width="18" Height="18">
                        <Viewbox>
                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M16,1 4,1C2.9,1 2,1.9 2,3L2,17 4,17 4,3 16,3ZM19,5 8,5C6.9,5 6,5.9 6,7L6,21C6,22.1 6.9,23 8,23L19,23C20.1,23 21,22.1 21,21L21,7C21,5.9 20.1,5 19,5ZM19,21 8,21 8,7 19,7Z" />
                        </Viewbox>
                        <Border Width="10"
                                Height="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource PopupBadgeBrush}"
                                CornerRadius="5">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PopupTextBrush}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="7"
                                       FontWeight="SemiBold"
                                       Text="原" />
                        </Border>
                    </Grid>
                </Button>
                <Button x:Name="CopyTranslationButton"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="复制译文"
                        Click="CopyTranslationButton_Click">
                    <Grid Width="18" Height="18">
                        <Viewbox>
                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M16,1 4,1C2.9,1 2,1.9 2,3L2,17 4,17 4,3 16,3ZM19,5 8,5C6.9,5 6,5.9 6,7L6,21C6,22.1 6.9,23 8,23L19,23C20.1,23 21,22.1 21,21L21,7C21,5.9 20.1,5 19,5ZM19,21 8,21 8,7 19,7Z" />
                        </Viewbox>
                        <Border Width="10"
                                Height="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource PopupBadgeBrush}"
                                CornerRadius="5">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PopupTextBrush}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="7"
                                       FontWeight="SemiBold"
                                       Text="译" />
                        </Border>
                    </Grid>
                </Button>
                <Button x:Name="PinButton"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="置顶并保留"
                        Click="PinButton_Click">
                    <Viewbox Width="17" Height="17">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M16,9 16,4 17,3 17,2 7,2 7,3 8,4 8,9C8,10.66 6.66,12 5,12L5,14 11,14 11,21 13,21 13,14 19,14 19,12C17.34,12 16,10.66 16,9Z" />
                    </Viewbox>
                </Button>
            </StackPanel>

            <TextBlock x:Name="TranslationTextBlock"
                       Grid.Row="1"
                       Margin="2,10,2,1"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource PopupTextBrush}"
                       FontFamily="Segoe UI, Microsoft YaHei UI"
                       FontSize="15"
                       LineHeight="23"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>
