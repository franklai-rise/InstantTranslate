<Window x:Class="InstantTranslate.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="InstantTranslate 设置"
        Icon="/Assets/AppLogo.ico"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Image Width="34"
                       Height="34"
                       Margin="0,0,10,0"
                       Source="/Assets/AppLogo.png" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource AccentBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="InstantTranslate" />
                    <TextBlock Foreground="#6B7280" FontSize="11" Text="快速全局划词翻译" />
                </StackPanel>
            </StackPanel>
            <CheckBox x:Name="EnabledCheckBox"
                      Margin="0,14,0,0"
                      Content="启用鼠标划词翻译" />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="选词后等待（毫秒）" />
                <TextBox x:Name="SelectionDelayTextBox" Grid.Row="0" Grid.Column="1" Text="80" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="源语言" />
                <ComboBox x:Name="SourceLanguageComboBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" IsEditable="True">
                    <ComboBoxItem Content="自动检测" />
                    <ComboBoxItem Content="英语" />
                    <ComboBoxItem Content="简体中文" />
                </ComboBox>
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="目标语言" />
                <ComboBox x:Name="TargetLanguageComboBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" IsEditable="True">
                    <ComboBoxItem Content="自动判断" />
                    <ComboBoxItem Content="简体中文" />
                    <ComboBoxItem Content="英语" />
                    <ComboBoxItem Content="日语" />
                </ComboBox>
                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="颜色风格" />
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Orientation="Horizontal">
                    <ComboBox x:Name="ColorThemeComboBox"
                              Width="270"
                              SelectedValuePath="Tag"
                              SelectionChanged="ColorThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="深海蓝" Tag="ocean" />
                        <ComboBoxItem Content="紫罗兰" Tag="violet" />
                        <ComboBoxItem Content="翡翠绿" Tag="emerald" />
                        <ComboBoxItem Content="暖橙色" Tag="sunset" />
                        <ComboBoxItem Content="玫瑰红" Tag="rose" />
                        <ComboBoxItem Content="自定义" Tag="custom" />
                    </ComboBox>
                    <Border x:Name="ThemePreviewBorder"
                            Width="30"
                            Height="30"
                            Margin="10,0,0,0"
                            CornerRadius="7"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1" />
                </StackPanel>
                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="自定义颜色" />
                <TextBox x:Name="CustomAccentColorTextBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         ToolTip="输入 #RRGGBB，例如 #2563EB"
                         TextChanged="CustomAccentColorTextBox_TextChanged" />
            </Grid>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,18,0,16" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="翻译 Provider" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,12"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Text="DeepSeek 使用官方 OpenAI-compatible 流式接口。API Key 仅保存在 Windows 凭据管理器中。" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="当前 Provider" />
                <ComboBox x:Name="ProviderComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          SelectedValuePath="Tag"
                          SelectionChanged="ProviderComboBox_SelectionChanged">
                    <ComboBoxItem Content="DeepSeek API" Tag="deepseek" />
                    <ComboBoxItem Content="Mock（离线测试）" Tag="mock" />
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="API Endpoint" />
                <TextBox x:Name="EndpointTextBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="Model" />
                <ComboBox x:Name="ModelComboBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" IsEditable="True">
                    <ComboBoxItem Content="deepseek-v4-flash" />
                    <ComboBoxItem Content="deepseek-v4-pro" />
                </ComboBox>
                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="API Key" />
                <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="86" Height="32" Margin="0,0,8,0" Content="取消" IsCancel="True" />
            <Button Width="86"
                    Height="32"
                    Content="保存"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
