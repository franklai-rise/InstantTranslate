<Application x:Class="InstantTranslate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="InterfaceFont">pack://application:,,,/Assets/Fonts/#Source Sans Pro</FontFamily>
        <!-- Neutral semantic surfaces keep the UI restrained and consistent. -->
        <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppCardBorderBrush" Color="#E5E5EA" />
        <SolidColorBrush x:Key="AppFieldBackgroundBrush" Color="#F2F2F7" />
        <SolidColorBrush x:Key="AppFieldBorderBrush" Color="#D1D1D6" />
        <SolidColorBrush x:Key="AppTextBrush" Color="#1D1D1F" />
        <SolidColorBrush x:Key="AppMutedTextBrush" Color="#6E6E73" />
        <SolidColorBrush x:Key="AppHoverBrush" Color="#E9E9ED" />
        <SolidColorBrush x:Key="AppPressedBrush" Color="#DEDEE3" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#16784A" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#76A0F2" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SwitchKnobBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#F7F7F8" />
        <SolidColorBrush x:Key="PopupBorderBrush" Color="#E2E2E5" />
        <SolidColorBrush x:Key="PopupButtonBrush" Color="#EEEEF0" />
        <SolidColorBrush x:Key="PopupButtonHoverBrush" Color="#DEDEE2" />
        <SolidColorBrush x:Key="PopupButtonBorderBrush" Color="#D7D7DB" />
        <SolidColorBrush x:Key="PopupTextBrush" Color="#1D1D1F" />
        <SolidColorBrush x:Key="PopupMutedBrush" Color="#6E6E73" />
        <SolidColorBrush x:Key="PopupBadgeBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="ContentHighlightPrimaryBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="ContentHighlightPrimaryBackgroundBrush" Color="#E8F0FF" />
        <SolidColorBrush x:Key="ContentHighlightSecondaryBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="ContentHighlightSecondaryBackgroundBrush" Color="#F1EAFE" />
        <SolidColorBrush x:Key="ContentHighlightTertiaryBrush" Color="#A16207" />
        <SolidColorBrush x:Key="ContentHighlightTertiaryBackgroundBrush" Color="#FFF3D8" />
        <SolidColorBrush x:Key="PopupHighlightBrush" Color="#00FFFFFF" />
        <sys:Boolean x:Key="PopupGlassEnabled">False</sys:Boolean>
        <SolidColorBrush x:Key="PopupTailBrush" Color="#F7F7F8" />
        <SolidColorBrush x:Key="PopupTailStrokeBrush" Color="#00FFFFFF" />
        <CornerRadius x:Key="PopupSurfaceCornerRadius">12</CornerRadius>
        <CornerRadius x:Key="PopupActionBarCornerRadius">11</CornerRadius>
        <CornerRadius x:Key="PopupButtonCornerRadius">7</CornerRadius>
        <effects:DropShadowEffect x:Key="PopupSurfaceShadowEffect"
                                 BlurRadius="0"
                                 ShadowDepth="0"
                                 Opacity="0" />
        <effects:DropShadowEffect x:Key="PopupActionBarShadowEffect"
                                 BlurRadius="0"
                                 ShadowDepth="0"
                                 Opacity="0" />
        <SolidColorBrush x:Key="ExplanationSurfaceBrush" Color="#EEF0F3" />
        <SolidColorBrush x:Key="ExplanationHeaderBrush" Color="#E4E7EC" />
        <SolidColorBrush x:Key="QuestionAnswerSurfaceBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="QuestionAnswerHeaderBrush" Color="#EEF2F8" />
        <SolidColorBrush x:Key="QuestionInputBrush" Color="#FFFFFF" />
    </Application.Resources>
</Application>
